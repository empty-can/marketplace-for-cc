{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/**)",
      "Read(**/*.reg)",
      "Edit(**/*.reg)",
      "Read(//**/*.reg)",
      "Edit(//**/*.reg)",
      "Edit(**/*.bat)",
      "Edit(//**/*.bat)",
      "Edit(**/*.cmd)",
      "Edit(//**/*.cmd)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(cd:*)",
      "Bash(pwd)",
      "Bash(wc:*)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:github.com/anthropics)",
      "WebFetch(domain:claude.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:agentskills.io)",
      "WebFetch(domain:anthropic.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:support.claude.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:pypi.org)",
      "Bash(claude --help)",
      "Bash(claude --version)",
      "Bash(claude plugin --help)",
      "Bash(claude plugin eval --help)",
      "mcp__github__search_repositories",
      "mcp__github__get_file_contents",
      "mcp__github__search_code",
      "mcp__github__list_branches",
      "mcp__github__list_commits",
      "mcp__github__get_commit"
    ]
  },
  "enabledMcpjsonServers": [
    "anthropic-docs",
    "context7",
    "fetch",
    "github"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git status --short"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "if": "Read(**/*.bat)",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/bat_cp932_guard.py", "pre"]
          },
          {
            "type": "command",
            "if": "Read(//**/*.bat)",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/bat_cp932_guard.py", "pre"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Read(.claude/.bat-shadow/**)",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/bat_cp932_guard.py", "post"]
          },
          {
            "type": "command",
            "if": "Edit(.claude/.bat-shadow/**)",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/bat_cp932_guard.py", "post"]
          },
          {
            "type": "command",
            "if": "Write(.claude/.bat-shadow/**)",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/bat_cp932_guard.py", "post"]
          },
          {
            "type": "command",
            "if": "Edit(**/*.ps1)",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/ps1_bom_crlf_check.py"]
          },
          {
            "type": "command",
            "if": "Write(**/*.ps1)",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/ps1_bom_crlf_check.py"]
          },
          {
            "type": "command",
            "if": "Edit(**/*.psm1)",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/ps1_bom_crlf_check.py"]
          },
          {
            "type": "command",
            "if": "Write(**/*.psm1)",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/ps1_bom_crlf_check.py"]
          },
          {
            "type": "command",
            "if": "Edit(**/*.psd1)",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/ps1_bom_crlf_check.py"]
          },
          {
            "type": "command",
            "if": "Write(**/*.psd1)",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/ps1_bom_crlf_check.py"]
          },
          {
            "type": "command",
            "if": "Edit(**/*.ps1.template)",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/ps1_bom_crlf_check.py"]
          },
          {
            "type": "command",
            "if": "Write(**/*.ps1.template)",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/ps1_bom_crlf_check.py"]
          }
        ]
      }
    ]
  }
}
